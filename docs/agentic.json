{
  "supercommand": "agentic",
  "description": "/api/v2/agentic",
  "resources": [
    {
      "name": "get",
      "path": "/api/v2/agentic/virtualagents/{virtualAgentId}",
      "description": "Get virtual agent."
    },
    {
      "name": "update",
      "path": "/api/v2/agentic/virtualagents/{virtualAgentId}",
      "description": "Update a virtual agent."
    },
    {
      "name": "delete",
      "path": "/api/v2/agentic/virtualagents/{virtualAgentId}/jobs",
      "description": "Start the deletion of a virtualAgent."
    },
    {
      "name": "get",
      "path": "/api/v2/agentic/virtualagents/{virtualAgentId}/jobs/{jobId}",
      "description": "Get a virtualAgent job."
    },
    {
      "name": "get",
      "path": "/api/v2/agentic/virtualagents/{virtualAgentId}/versions/{versionId}/jobs/{jobId}",
      "description": "Get the status of the publishing job for this virtual agent version."
    },
    {
      "name": "get",
      "path": "/api/v2/agentic/virtualagents/{virtualAgentId}/versions/{versionId}",
      "description": "Get a virtual agent version."
    },
    {
      "name": "update",
      "path": "/api/v2/agentic/virtualagents/{virtualAgentId}/versions/{versionId}",
      "description": "Update a virtual agent version."
    },
    {
      "name": "create",
      "path": "/api/v2/agentic/virtualagents/{virtualAgentId}/versions/{versionId}/jobs",
      "description": "Start the publishing of a virtual agent version."
    },
    {
      "name": "create",
      "path": "/api/v2/agentic/virtualagents/{virtualAgentId}/versions",
      "description": "Create a virtual agent version."
    },
    {
      "name": "list",
      "path": "/api/v2/agentic/virtualagents",
      "description": "Get all virtual agents."
    },
    {
      "name": "create",
      "path": "/api/v2/agentic/virtualagents",
      "description": "Create a virtual agent."
    }
  ]
}